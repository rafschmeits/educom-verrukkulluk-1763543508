{% extends 'main.html.twig' %}

{% block content %}
<div class="container mt-5">
  <h2 class="text-center mb-4">Favorieten!</h2>

  {% if favorieten is not empty %}
    <div class="row row-cols-1 row-cols-md-2 g-4">
      {% for gerecht in favorieten %}
        <div class="col">
          <div class="card h-100 shadow-sm">
            <div class="row g-0">
              <div class="col-md-4">
                <img src="{{ gerecht.afbeelding }}" alt="{{ gerecht.titel }}" class="img-fluid rounded-start" style="object-fit: cover; height: 100%;">
              </div>
              <div class="col-md-8">
                <div class="card-body d-flex justify-content-between align-items-center">
                  <div>
                    <h5 class="card-title">{{ gerecht.titel }}</h5>
                    <p class="card-text">{{ gerecht.korte_omschrijving }}</p>
                  </div>
                  <!-- hartje om te verwijderen -->
                  <a href="index.php?favorite=delete&id={{ gerecht.id }}&from=favorieten" class="text-danger">
                    <i class="bi bi-heart-fill"></i>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  {% else %}
    <p class="text-center">Je hebt nog geen favoriete gerechten toegevoegd.</p>
  {% endif %}
</div>
{% endblock %}

