{% extends "main.html.twig" %}

{% block content %}
<div class="gerecht-grid gerechten-container">
    {% for gerecht in gerechten %}
        <div class="gerecht-card">
            <img src="{{ gerecht.afbeelding }}" alt="{{ gerecht.titel }}" class="gerecht-foto">
            <h2>{{ gerecht.titel }}</h2>
            <p>{{ gerecht.korte_omschrijving }}</p>

            <!-- Info rij -->
            <div class="gerecht-info d-flex justify-content-between align-items-center mb-2">
                <span>👨‍👩‍👧‍👦 4 personen</span>
                <span>🍽 {{ gerecht.calories }} kcal</span>
                <span>💰 €{{ gerecht.price|number_format(2, ',', '.') }}</span>
                <span>⭐ {{ gerecht.rating ?? 'Geen rating' }}</span>
            </div>

            <!-- Smullen button -->
   <a href="index.php?id={{ gerecht.id }}" class="btn smullen-btn mt-3">Smullen!</a>

        </div>
    {% endfor %}
</div>
{% endblock %}
